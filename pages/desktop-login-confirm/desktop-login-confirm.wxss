/* pages/desktop-login-confirm · 手账风（复用 style/handdrawn.wxss 全局类） */
.confirm-page {
  min-height: 100vh;
}

.dl-card {
  margin-top: 60rpx;
  background: var(--cream-soft);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-soft);
  box-shadow: var(--shadow-paper);
  padding: 48rpx 40rpx;
}

.dl-head {
  text-align: center;
  margin-bottom: 36rpx;
}

.dl-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-deep);
  letter-spacing: 2rpx;
}

.dl-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 10rpx;
}

.dl-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 240rpx;
  justify-content: center;
}

.dl-text {
  font-size: 30rpx;
  color: var(--ink);
  text-align: center;
  line-height: 1.7;
}

.dl-text.dl-ok {
  color: var(--pink-deep);
  font-weight: 600;
}

.dl-device {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  background: var(--card-warm);
  border: 3rpx dashed var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 14rpx 30rpx;
}

.dl-actions {
  margin-top: 44rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dl-actions .btn-primary,
.dl-actions .btn-ghost {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 44rpx;
  font-size: 30rpx;
}

.dl-foot {
  margin-top: 30rpx;
  text-align: center;
}

.dl-foot .btn-ghost {
  display: inline-block;
  min-width: 300rpx;
  padding: 18rpx 60rpx;
  font-size: 28rpx;
}
