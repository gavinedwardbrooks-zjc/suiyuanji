/* ============================================================
   pages/home/home.wxss —— M3 治愈系重塑（2026-08-28）
   风格：奶油底 / 便签条带 / 糖按钮 / 装饰元素散落
   ============================================================ */

.page-pad { padding: 24rpx 24rpx 80rpx; }

.block { margin-top: 24rpx; }
.section-row { margin-bottom: 14rpx; }

.tap { cursor: pointer; }

/* 统一：tap 区域触摸反馈（小程序原生 hover-class） */

/* ==========================
   Hero 大插画区（参考图顶部奶油纸感）
   ========================== */
.hero-big {
  position: relative;
  background: var(--illustr-paper);
  border-radius: var(--radius-soft);
  border: 3rpx solid var(--line-sketch);
  box-shadow: var(--shadow-soft-ink);
  padding: 40rpx 36rpx 32rpx;
  margin-top: 12rpx;
  overflow: hidden;
}
.greeting-h {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-deep);
  letter-spacing: 2rpx;
  line-height: 1.3;
}
.hero-date {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-soft);
}
.hero-art {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.journal-sticker {
  width: 260rpx;
  height: 190rpx;
  margin: 18rpx auto 0;
  background: var(--cream-soft);
  border: 3rpx solid var(--line-sketch);
  border-radius: 28rpx 36rpx 24rpx 40rpx;
  box-shadow: var(--shadow-sticker);
  transform: rotate(-3deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.journal-sticker::before,
.journal-sticker::after {
  content: '';
  position: absolute;
  width: 42rpx;
  height: 14rpx;
  background: var(--sticky-pink-bg);
  opacity: .85;
}
.journal-sticker::before { top: -10rpx; left: 28rpx; transform: rotate(-12deg); }
.journal-sticker::after { right: 24rpx; bottom: -8rpx; transform: rotate(9deg); }
.sticker-ring { width: 76rpx; height: 76rpx; border: 4rpx solid var(--candy-pink-deep); border-radius: 50%; }
.sticker-mark { margin-top: -64rpx; color: var(--candy-pink-deep); font-size: 48rpx; line-height: 1; }
.sticker-label { margin-top: 18rpx; color: var(--text-soft); font-size: 24rpx; letter-spacing: 4rpx; }

.hero-illust {
  width: 360rpx;
  height: 288rpx;
}
.hero-deco-row {
  margin-top: 14rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
}
.hero-deco-row .mini-flower,
.hero-deco-row .mini-heart,
.hero-deco-row .mini-sprout {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.95;
}

/* ==========================
   H2 空状态（轻量便签提示卡 · 无大插画 · 无装饰）
   ========================== */
.empty-state {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 40rpx 36rpx;
  background: var(--card);
  border-radius: var(--radius-soft);
  box-shadow: var(--shadow-soft-ink);
  border: 3rpx dashed var(--line-sketch);
  min-height: 180rpx;
  overflow: hidden;
}
.empty-title {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-deep);
}
.empty-sub {
  margin-top: 2rpx;
  font-size: 26rpx;
  color: var(--text-soft);
}
.empty-cta {
  margin-top: 18rpx;
  width: 60%;
  /* 修复：candy-btn 自带实心偏移阴影（0 8rpx 0）会在按钮正下方形成实体色条，
     真机观感像「装饰物露出」——空状态内改为柔和投影，杜绝按钮下方任何图形 */
  box-shadow: var(--shadow-soft-ink);
}
.candy-btn { display: block; text-align: center; }

/* ==========================
   H1-2 今日状态（note-pink）
   ========================== */
.note-pink .status-row {
  display: flex;
  align-items: stretch;
  gap: 24rpx;
  position: relative;
  z-index: 2;
}
.stat { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.stat-label { font-size: 24rpx; color: var(--text-soft); }
.stat-value { font-size: 36rpx; font-weight: 700; color: var(--candy-pink-deep); }
.stat-word { font-size: 24rpx; color: var(--text-soft); }
.hand-unit { font-size: 28rpx; color: var(--text-soft); font-weight: 600; }
.mood-stat { align-items: flex-end; }
.mood-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.mood-ico { width: 72rpx; height: 72rpx; }
.mood-ico.sm { width: 56rpx; height: 56rpx; }

/* ==========================
   H1-3 今日三件大事（三色便签条带堆叠）
   ========================== */
.goals-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.goal-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
}
.goal-num { flex-shrink: 0; }
.goal-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-deep);
  font-weight: 600;
}
.goal-card .deco-cute {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}
.goal-card.goal-done .goal-text {
  color: var(--text-faint);
  text-decoration: line-through;
  text-decoration-color: var(--text-soft);
}
.goal-card.goal-empty {
  cursor: pointer;
  border-style: dashed !important;
  opacity: 0.85;
}
.goal-card.goal-empty .goal-text {
  color: var(--text-soft);
  font-weight: 500;
}

/* H1-4 小事 */
.progress-row { display: flex; align-items: center; gap: 18rpx; }
.bar {
  flex: 1;
  height: 20rpx;
  background: var(--cream-paper);
  border-radius: 999rpx;
  overflow: hidden;
  border: 2rpx solid var(--line);
}
.bar-fill {
  height: 100%;
  background: var(--pink-deep);
  border-radius: 999rpx;
  transition: width .4s var(--ease);
}

/* H3 AI 小结 */
.summary-text {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--text-deep);
  line-height: 1.75;
}

/* ==========================
   H4 最近 7 天（note-yellow）
   ========================== */
.week-row {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}
.week-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}
.week-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line-sketch);
  background: transparent;
  transition: all .3s var(--ease);
}
.week-dot.on {
  background: var(--candy-pink-deep);
  border-color: var(--candy-pink-deep);
  transform: scale(1.15);
}
.week-col.today .week-date {
  color: var(--candy-pink-deep);
  font-weight: 800;
}
.week-date { font-size: 22rpx; color: var(--text-soft); }
.small { font-size: 24rpx; }

/* ==========================
   陪伴方 · 纪念日主视觉（天数放大）
   —— 只做排版层级：大字 = 在一起天数，其余降级为辅助行
   ========================== */
.anni-hero {
  padding: 34rpx 34rpx 30rpx;
  border-radius: var(--radius-soft);
  border: 3rpx solid var(--sticky-pink-edge);
  background: var(--sticky-pink-bg);
}
.anni-hero-top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.anni-hero-greet {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-deep);
}
.anni-hero-date {
  font-size: 22rpx;
  color: var(--text-soft);
  flex-shrink: 0;
}
.anni-hero-days {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
}
.anni-hero-num {
  font-size: 132rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -4rpx;
  color: var(--candy-pink-deep);
}
.anni-hero-unit {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-soft);
}
.anni-hero-cap {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-soft);
}

/* V1.1 今日决定：两张紧凑卡片（一行标题 + 一行结果，长了就省略） */
.day-choice { padding: 22rpx 26rpx; }
.day-choice .section-sub { max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
