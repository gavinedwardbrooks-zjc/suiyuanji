<view class="book-edit page-pad"><view class="hero"><text class="title">添加一本书</text><text class="subtitle">把想读的书，先记在这里</text></view><view class="paper-card form-card"><input class="soft-input" placeholder="书名（必填）" value="{{name}}" bindinput="onName" adjust-position="true" cursor-spacing="24" /><input class="soft-input" placeholder="作者（可选）" value="{{author}}" bindinput="onAuthor" adjust-position="true" cursor-spacing="24" /><view class="status-list"><text wx:for="{{statuses}}" wx:key="value" class="sticker-tag {{status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectStatus">{{item.label}}</text></view><input class="soft-input" type="number" placeholder="当前进度 0-100" value="{{progressPercent}}" bindinput="onProgress" adjust-position="true" cursor-spacing="24" /><input class="soft-input" type="number" placeholder="阅读分钟" value="{{minutes}}" bindinput="onMinutes" adjust-position="true" cursor-spacing="24" /><textarea class="soft-input note" placeholder="想记下什么（可选）" value="{{note}}" bindinput="onNote" adjust-position="true" cursor-spacing="24" /></view><button class="soft-button primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存到书单</button></view>
