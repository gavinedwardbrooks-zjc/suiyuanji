.book-edit { min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); background: var(--notebook-bg); }.hero { padding: 30rpx 0; text-align: center; }.title { display: block; font-size: 40rpx; font-weight: 700; color: var(--text-deep); }.subtitle { color: var(--text-soft); font-size: 24rpx; }.form-card { padding: 28rpx; display: flex; flex-direction: column; gap: 18rpx; }.soft-input { background: var(--cream-soft); border: 2rpx solid var(--notebook-line); border-radius: 18rpx; padding: 20rpx; color: var(--text-deep); box-sizing: border-box; }.note { min-height: 180rpx; width: 100%; }.status-list { display: flex; flex-wrap: wrap; gap: 14rpx; }.sticker-tag { padding: 10rpx 18rpx; border-radius: 18rpx; background: var(--cream-soft); color: var(--text-soft); font-size: 24rpx; }.sticker-tag.active { background: var(--sticky-pink-bg); color: var(--pink-deep); }.soft-button { margin-top: 28rpx; min-height: 88rpx; border-radius: 999rpx; background: var(--candy-pink); color: #fff; }
