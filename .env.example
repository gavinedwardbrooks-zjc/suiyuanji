# ============================================================
# 碎愿集（Suiyuanji）环境变量示例
# ============================================================
# 用法：复制本文件为 .env（或直接在微信云开发控制台为每个云函数
# 单独配置环境变量），填入你自己的值。真实密钥绝不提交仓库。
#
# 注意：微信云开发的环境变量是「按云函数」配置的，本文件仅作
# 集中示例，方便对照。实际请到「云开发控制台 → 云函数 → 对应函数
# → 配置 → 环境变量」逐个填写。
# ============================================================

# ---------- AI 小结（aiSummary 云函数） ----------
# OpenAI 兼容接口地址（留空则走内置降级模板，不调用 AI）
AI_API_URL=
# AI 接口密钥（**密钥，仅填在云端环境变量，绝不提交仓库**）
AI_API_KEY=
# 模型名（缺省 gpt-3.5-turbo）
AI_MODEL=gpt-3.5-turbo
# 小结订阅消息模板 ID（可选）
TPL_SUMMARY=

# ---------- 生活规划（lifePlanner 云函数） ----------
# 复用 AI_API_URL / AI_API_KEY / AI_MODEL
# 心愿安排订阅模板 ID（可选）
TPL_ARRANGE=

# ---------- 订阅消息模板 ID（dailyRecord / getPartnerView / menstrual） ----------
# 聊天消息通知模板 ID（缺省用 config.js 内置默认值）
TPL_CHAT=
# 经期提醒模板 ID（缺省用 config.js 内置默认值）
TPL_PERIOD=

# ---------- 目标提醒（reminderCheck 云函数） ----------
# 目标提醒订阅模板 ID（未配置则 reminderCheck 静默跳过，不误发）
TPL_REMIND=
