.sp { width: 100%; }
.display {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 4rpx;
}
.display.tappable { cursor: pointer; }
.big {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  transform-origin: center;
}
.meta { display: flex; flex-direction: column; flex: 1; }
.label { font-size: 24rpx; color: var(--ink-soft); }
.score { font-size: 36rpx; font-weight: 700; color: var(--pink-deep); }
.word { font-size: 24rpx; color: var(--ink-soft); }
.arrow { color: var(--ink-faint); font-size: 22rpx; }

/* 三档表情动画 */
.shake { animation: shake .55s ease; }
.bounce { animation: bounce .55s var(--ease); }
.calm { animation: calm .55s ease; }
@keyframes shake {
  0%, 100% { transform: rotate(0); }
  20% { transform: rotate(-14deg); }
  40% { transform: rotate(12deg); }
  60% { transform: rotate(-8deg); }
  80% { transform: rotate(4deg); }
}
@keyframes bounce {
  0% { transform: scale(1); }
  45% { transform: scale(1.28) translateY(-10rpx); }
  100% { transform: scale(1); }
}
@keyframes calm {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.picker {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 8rpx;
  background: var(--card-warm);
  border-radius: var(--radius-sm);
}
.heart {
  width: 64rpx;
  height: 64rpx;
  opacity: .35;
  transition: all .2s var(--ease);
  filter: grayscale(1);
}
.heart-ico {
  width: 100%;
  height: 100%;
}
.heart.on { opacity: 1; transform: scale(1.12); filter: grayscale(0); }
